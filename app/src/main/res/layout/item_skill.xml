<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2D9F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/skillTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chemie-Nachhilfe"
            android:textColor="#2E2638"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skillCategoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EEE7FA"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Kategorie"
            android:textColor="#6045A5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skillDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Beschreibung des Skills"
            android:textColor="#5B5562"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/skillLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Niveau: Fortgeschritten"
                android:textColor="#706979"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/skillOwnerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="von Besa"
                android:textColor="#6045A5"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/skillActionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/editSkillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bearbeiten" />

            <Button
                android:id="@+id/deleteSkillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Löschen" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>